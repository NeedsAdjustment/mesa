{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mesa",
  "version": "0.1.7",
  "identifier": "com.needsadjustment.mesa",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QjBEOTA2NjA4RDMyRUMKUldUc01vMWdCdG13cVVHZ1c0b0ZXTjRUR0dmMExqZEQwVGJWWUxHTmlkTm9KTldocUVjWWJETGIK",
      "endpoints": [
        "https://github.com/NeedsAdjustment/mesa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
